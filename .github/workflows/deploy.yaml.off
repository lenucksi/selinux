name: Build and Deploy Signed Repository

on:
  push:
    branches: [master]
  workflow_dispatch:
  schedule:
    - cron: '0 0 * * 0'

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    container:
      image: archlinux:base-devel
      options: --privileged
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1

      - name: Import GPG key
        id: gpg
        uses: crazy-max/ghaction-import-gpg@2dc316deee8e90f13e1a351ab510b4d5bc0c82cd # v7.0.0
        with:
          gpg_private_key: ${{ secrets.GPG_PRIVATE_KEY }}
          passphrase: ${{ secrets.GPG_PASSPHRASE }}

      - name: Setup build environment
        run: |
          pacman -Syu --noconfirm
          pacman -S --noconfirm base-devel git pacman-contrib
          useradd -m builder
          echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
          chown -R builder:builder .
          mkdir -p /packages
          chmod 777 /packages

      - name: Build and sign dependency chain
        env:
          GPGKEY: ${{ steps.gpg.outputs.fingerprint }}
        run: |
          GPG_DIR=$(gpgconf --list-dirs homedir)
          cp -r "$GPG_DIR" /home/builder/.gnupg
          chown -R builder:builder /home/builder/.gnupg
          chmod 700 /home/builder/.gnupg
          chmod 600 /home/builder/.gnupg/pubring.kbx /home/builder/.gnupg/trustdb.gpg 2>/dev/null || true
          chmod 700 /home/builder/.gnupg/private-keys-v1.d 2>/dev/null || true
          chmod 600 /home/builder/.gnupg/private-keys-v1.d/* 2>/dev/null || true
          chmod 644 /home/builder/.gnupg/*.conf 2>/dev/null || true

          build_and_sign() {
            local dir="$1"
            cd "$dir"
            sudo -u builder \
              GNUPGHOME=/home/builder/.gnupg \
              GPGKEY="$GPGKEY" \
              PKGDEST=/packages \
              makepkg --syncdeps --noconfirm --sign || exit 1
            cd ..
          }

          build_and_sign libsepol
          pacman --noconfirm -U /packages/libsepol-*.pkg.tar.zst || exit 1

          build_and_sign libselinux
          pacman --noconfirm -U /packages/libselinux-*.pkg.tar.zst || exit 1

          build_and_sign checkpolicy
          pacman --noconfirm -U /packages/checkpolicy-*.pkg.tar.zst || exit 1

          build_and_sign semodule-utils
          pacman --noconfirm -U /packages/semodule-utils-*.pkg.tar.zst || exit 1

          build_and_sign libsemanage
          pacman --noconfirm -U /packages/libsemanage-*.pkg.tar.zst || exit 1

          build_and_sign policycoreutils
          pacman --noconfirm -U /packages/policycoreutils-*.pkg.tar.zst || exit 1

          build_and_sign selinux-refpolicy-arch

      - name: Create signed pacman repository
        env:
          GPGKEY: ${{ steps.gpg.outputs.fingerprint }}
        run: |
          mkdir -p repo/x86_64
          cp /packages/*.pkg.tar.zst repo/x86_64/
          for sig in /packages/*.pkg.tar.zst.sig; do
            [ -f "$sig" ] && cp "$sig" repo/x86_64/
          done
          cp public.asc repo/x86_64/
          gpg --verify repo/x86_64/*.pkg.tar.zst.sig || exit 1
          repo-add --sign --verify --include-sigs --key "$GPGKEY" \
            repo/x86_64/selinux.db.tar.zst repo/x86_64/*.pkg.tar.zst
          cd repo/x86_64
          ln -sf selinux.db.tar.zst selinux.db
          ln -sf selinux.files.tar.zst selinux.files

      - name: Verify signatures
        run: |
          for pkg in repo/x86_64/*.pkg.tar.zst; do
            gpg --verify "${pkg}.sig" "${pkg}" || exit 1
          done
          echo "All signatures verified successfully"

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: repo

  deploy:
    needs: build
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@cd2ce8fcbc39b97be8ca5fce6e763baed58fa128 # v5.0.0
